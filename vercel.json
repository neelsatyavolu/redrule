{
  "installCommand": "npm ci --prefix sharing",
  "buildCommand": "node scripts/assemble-vercel-site.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "redrule.n3el.dev" }], "destination": "https://redrule.xanom.co/", "permanent": true },
    { "source": "/index.html", "has": [{ "type": "host", "value": "redrule.n3el.dev" }], "destination": "https://redrule.xanom.co/", "permanent": true },
    { "source": "/privacy", "has": [{ "type": "host", "value": "redrule.n3el.dev" }], "destination": "https://redrule.xanom.co/privacy", "permanent": true },
    { "source": "/privacy.html", "has": [{ "type": "host", "value": "redrule.n3el.dev" }], "destination": "https://redrule.xanom.co/privacy", "permanent": true },
    { "source": "/terms", "has": [{ "type": "host", "value": "redrule.n3el.dev" }], "destination": "https://redrule.xanom.co/terms", "permanent": true },
    { "source": "/terms.html", "has": [{ "type": "host", "value": "redrule.n3el.dev" }], "destination": "https://redrule.xanom.co/terms", "permanent": true },
    { "source": "/llms.txt", "has": [{ "type": "host", "value": "redrule.n3el.dev" }], "destination": "https://redrule.xanom.co/llms.txt", "permanent": true },
    {
      "source": "/download",
      "destination": "https://github.com/neelsatyavolu/redrule/releases/latest/download/Redrule.dmg",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/f/:id/mcp", "destination": "/api/folder-mcp?id=:id" },
    { "source": "/s/:id", "destination": "/api/note?id=:id" },
    { "source": "/f/:id", "destination": "/api/folder-page?id=:id" },
    { "source": "/f/:id/m/:meeting", "destination": "/api/folder-page?id=:id&meeting=:meeting" }
  ],
  "headers": [
    {
      "source": "/s/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/f/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
